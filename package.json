{
  "name": "developer-dashboard",
  "version": "1.0.0",
  "description": "Full-stack developer dashboard with real-time sync and analytics",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "cd client && npm run dev --host",
    "build": "npm run build:server && npm run build:client",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "start": "node dist/index.js",
    "build:server": "tsc",
    "build:client": "cd client && npm run build"
  },
  "keywords": [
    "dashboard",
    "websocket",
    "analytics",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
